{
  "name": "@mnci/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint,typecheck,test,build",
    "graph": "nx graph",
    "release:preview": "nx release --dry-run",
    "prepare": "husky",
    "lint:ox": "oxlint packages"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@mnci/eslint-config": "*",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/rollup": "23.1.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.46",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-tsdoc-require-2": "^1.2.3",
    "husky": "^9.1.7",
    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "jest-util": "~30.4.1",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "rollup": "^4.62.4",
    "swc-loader": "0.1.15",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "verdaccio": "^6.9.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {},
  "overrides": {
    "nx": {
      "axios": "^1.18.1",
      "brace-expansion": "^5.0.8"
    },
    "@verdaccio/config": {
      "js-yaml": "^4.3.1"
    },
    "@verdaccio/middleware": {
      "express": "^4.22.2"
    },
    "verdaccio-audit": {
      "express": "^4.22.2"
    },
    "@cypress/request": {
      "qs": "^6.15.3",
      "uuid": "^11.1.1"
    },
    "esbuild": "^0.28.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "fast-uri": "^3.1.5",
    "postcss": {
      ".": "^8.5.26",
      "nanoid": "^3.3.18"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    }
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --ignore-pattern \"packages/**\" --ignore-pattern package-lock.json",
          "cwd": "."
        }
      }
    }
  }
}
