{
  "name": "@mnci/eslint-config",
  "version": "0.1.0",
  "type": "module",
  "description": "The shared ESLint flat config every mnci-generated monorepo uses \u2014 one root config, non-stylistic rules only, covering TS/JS, React, JSON/JSONC/JSON5, YAML, Markdown, CSS and HTML.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./configs/*": "./configs/*.js",
    "./package.json": "./package.json",
    "./prettier": "./prettier.js"
  },
  "files": [
    "index.js",
    "prettier.js",
    "configs"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "mnci",
    "nx"
  ],
  "author": "Eduardo Russo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/MoNecromanCi.git",
    "directory": "packages/eslint-config"
  },
  "peerDependencies": {
    "@nx/eslint-plugin": ">=21",
    "eslint": "^10.4.0"
  },
  "peerDependenciesMeta": {
    "@nx/eslint-plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.0",
    "@eslint/markdown": "^8.0.2",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jsonc": "^3.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.7.0",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.1",
    "toml-eslint-parser": "^1.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
