{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2021",
    "lib": ["es2021"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "exclude": ["./coverage/**", "./dist/**", "./doc/**", "./node_modules/**"]
}
