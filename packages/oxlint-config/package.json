{
  "name": "@mnci/oxlint-config",
  "version": "0.1.0",
  "type": "module",
  "description": "The shared oxlint + oxfmt config every mnci-generated monorepo can use — the same lint and style opinion as @mnci/eslint-config, on the Rust toolchain, with the rules oxlint lacks bridged from the real ESLint plugins.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./configs/*": "./configs/*.js",
    "./oxfmt": "./oxfmt.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "oxfmt.js",
    "configs"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "lint",
    "mnci",
    "nx"
  ],
  "author": "Eduardo Russo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/MoNecromanCi.git",
    "directory": "packages/oxlint-config"
  },
  "peerDependencies": {
    "oxlint": "^1.78.0"
  },
  "dependencies": {
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "oxfmt": "^0.61.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "jest": "^30.4.2",
    "oxlint": "^1.78.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
